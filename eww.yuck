(defwindow bar-left
	:monitor 0
	:geometry (geometry :x "0%"
		:y "0%"
		:width "100%"
		:height "32px"
		:anchor "top center")
	:stacking "fg"
	:windowtype "dock"
	:exclusive true
	:wm-ignore false
	(bar :monitor_name "HDMI-A-1"
		(test)
		(test)
		(test)
	)
)

(defwindow bar-right
	:monitor 1
	:geometry (geometry :x "0%"
		:y "0%"
		:width "100%"
		:height "32px"
		:anchor "top center")
	:stacking "fg"
	:windowtype "dock"
	:exclusive true
	:wm-ignore false
	(bar :monitor_name "DP-1"
		(another)
		(another)
		(another)
	)
)