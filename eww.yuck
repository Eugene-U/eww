; 		:class "bar"
; 		(test)
; 		(test)
; 		(test)
; 	)
; )

(defwidget bar [monitor_name]
		(overlay
		(centerbox
			:class "bar"
			(box (children :nth 0))
			(box (children :nth 1))
			(box (children :nth 2))
		)
		(box
			:class "bar-active-line"
			:style {active_monitor == monitor_name
				? "background-color: #d6acff;"
				: "background-color: #392b4d;"}
			:halign "fill"
			:valign "end"
			:height 2
		)
	)
)


